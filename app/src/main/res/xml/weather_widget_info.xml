<?xml version="1.0" encoding="utf-8"?>
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:minWidth="280dp"
    android:minHeight="160dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:minResizeWidth="96dp"
    android:minResizeHeight="50dp"
    android:maxResizeWidth="600dp"
    android:maxResizeHeight="600dp"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/widget_weather_artwork"
    android:previewLayout="@layout/widget_weather_preview"
    android:previewImage="@drawable/widget_preview_large"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:widgetFeatures="reconfigurable"
    android:configure="com.moon.weather.widget.WeatherWidgetConfigureActivity"
    app:previewLayoutSmall="@layout/widget_preview_forecast_180x80"
    app:previewLayoutMedium="@layout/widget_preview_forecast_170x170"
    app:previewLayoutWideSmall="@layout/widget_preview_forecast_340x80"
    app:previewLayoutLarge="@layout/widget_preview_forecast_340x180"
    app:allowMultipleSizes="true"
    app:widgetStyle="colorful"
    app:previewSize="small|wideSmall|medium|large"
    app:widgetSize="small|wideSmall|medium|large|extraLarge|extraLargeLong"
    app:featuredWidget="small|wideSmall|medium|large" />


