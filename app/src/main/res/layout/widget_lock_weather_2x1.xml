<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:gravity="center" android:padding="4dp"
    android:background="@android:color/transparent">
    <ImageView android:id="@+id/lock_weather_icon" android:layout_width="28dp" android:layout_height="28dp"
        android:src="@drawable/some_clouds_day" android:scaleType="fitCenter"
        android:tint="#FFFFFFFF" android:tintMode="src_in"
        android:contentDescription="@string/lock_weather_wide_name" />
    <TextView android:id="@+id/lock_weather_temperature" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginStart="8dp" android:text="--°" android:textColor="#FFFFFFFF"
        android:textSize="24sp" android:fontFamily="sans-serif-medium" android:includeFontPadding="false"
        android:maxLines="1" android:gravity="center" />
</LinearLayout>
